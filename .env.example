# Enable the live Microsoft Teams integration tests.
RUN_LIVE_TEAMS_TESTS=false

# Azure Bot / Microsoft Entra application credentials.
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=

# A conversation reference captured from a verified inbound Teams activity.
# Use Jido.Chat.Teams.ConversationRef.encode/1 to create this value.
TEAMS_TEST_CONVERSATION_REF=

# Optional activity ID for a live reply check.
TEAMS_TEST_REPLY_TO_ID=
